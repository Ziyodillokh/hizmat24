{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testTimeout": 180000,
  "moduleNameMapper": {
    "^@shared/(.*)$": "<rootDir>/libs/shared-kernel/src/$1",
    "^@client/(.*)$": "<rootDir>/apps/client-api/src/$1"
  }
}
