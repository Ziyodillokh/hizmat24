NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://hizmat24:hizmat24@localhost:5432/hizmat24?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Kamida 32 belgi. Production'da secret manager orqali beriladi.
JWT_ACCESS_SECRET=change-me-to-a-32-character-minimum-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP hashi uchun ALOHIDA sir — JWT siri bilan bir xil bo'lmasin.
OTP_HASH_SECRET=change-me-to-a-different-32-char-secret

# console | eskiz | playmobile
# DIQQAT: "console" OTP kodini logga ochiq yozadi — production'da ilova ko'tarilmaydi.
SMS_PROVIDER=console
# SMS_API_URL=https://notify.eskiz.uz/api/message/sms/send
# SMS_API_TOKEN=
SMS_SENDER=4546

FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Vergul bilan ajratilgan Origin'lar. Bo'sh bo'lsa CORS umuman yoqilmaydi
# (mobil ilova uchun kerak emas). Hech qachon "*" ishlatmang.
CORS_ORIGINS=

# Bo'sh bo'lsa /metrics endpointi yopiq qoladi.
# METRICS_TOKEN=

# FAQAT development/test: OTP kodini API javobida qaytaradi.
# Production'da true bo'lsa ilova ataylab ishga tushmaydi.
OTP_DEBUG_RETURN_CODE=false

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
