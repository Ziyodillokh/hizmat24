// Hizmat24 — mijoz ilovasi backend uchun ma'lumotlar modeli.
// Barcha pul qiymatlari — butun sonda, faqat UZS (so'm). Valyuta maydoni yo'q.
// Barcha vaqtlar UTC'da saqlanadi (@db.Timestamptz), mijozga Asia/Tashkent'da qaytariladi.

generator client {
  provider      = "prisma-client-js"
  // Distroless (Debian 12) imiji uchun dvijok: `native` faqat build
  // mashinasiga mos keladi, konteynerda esa openssl 3 li Debian dvijoki
  // kerak. Busiz API imijda «Query engine library not found» bilan
  // koʻtarilmaydi.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────── enums ──

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// Narx qanday koʻrsatiladi: aniq summa yoki «shundan boshlab».
///
/// Baʼzi ishning hajmi joyida maʼlum boʻladi (quvur almashtirish uzunligiga
/// qarab). Bunda aniq son yozish — mijozga yolgʻon vaʼda; `FROM` esa buni
/// ochiq aytadi.
enum ServicePriceKind {
  FIXED
  FROM
}

enum ComplexityLevel {
  SIMPLE
  COMPLEX
}

enum MasterExperienceLevel {
  NEW
  EXPERIENCED
}

enum MasterStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

/// Usta arizasining holati. Uch qiymat yetarli: ariza koʻrib chiqilishini
/// kutadi, qabul qilinadi yoki sabab bilan rad etiladi. «Koʻrib chiqilmoqda»
/// degan oraliq holat ataylab YOʻQ — u foydalanuvchiga hech narsa aytmaydi,
/// panelda esa bir moderator boshqasini bloklab qoʻyishiga olib kelardi.
enum MasterApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  SEARCHING
  SEARCHING_QUEUED
  ASSIGNED
  MASTER_EN_ROUTE
  ARRIVED_PENDING_CONFIRMATION
  IN_PROGRESS
  COMPLETED_BY_MASTER
  RATED
  CLOSED
  CANCELLED
  SAFETY_FLAGGED
}

/// Toʻlov usuli. Qiymatlar ilovadagi `PaymentMethod` bilan bir xil maʼnoda:
/// `cash` — naqd, `card` — bank kartasi, `escrow` — kafolatli toʻlov.
enum PaymentMethod {
  CASH
  CARD
  ESCROW
}

enum CancelledBy {
  CLIENT
  MASTER
  SYSTEM
}

enum NotificationType {
  MASTER_ASSIGNED
  MASTER_EN_ROUTE
  MASTER_ARRIVED
  QUEUE_POSITION_UPDATE
  ORDER_IN_PROGRESS
  ORDER_COMPLETED_BY_MASTER
  ORDER_CANCELLED
  SAFETY_ALERT_RECEIVED
  MATCHING_ESCALATED
}

enum SafetyAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AuditAction {
  ORDER_STATUS_CHANGED
  SAFETY_FLAG_RAISED
  MASTER_ASSIGNED
  MASTER_ACK_TIMEOUT
  MATCHING_ESCALATED
  ORDER_CANCELLED
  ADMIN_LOGIN_SUCCEEDED
  ADMIN_LOGIN_FAILED
  ADMIN_LOCKED
  ADMIN_LOGGED_OUT
  CATALOG_CATEGORY_CREATED
  CATALOG_CATEGORY_UPDATED
  CATALOG_PRICE_CHANGED
  MASTER_SERVICES_CHANGED
  MASTER_APPLICATION_SUBMITTED
  MASTER_APPLICATION_APPROVED
  MASTER_APPLICATION_REJECTED
}

/// Admin panel rollari. Har biri OLDINGIsining ruxsatlarini oʻz ichiga
/// olmaydi — bular alohida vazifalar, ierarxiya emas: moderator ustalarni
/// tekshiradi, operator buyurtmalarni kuzatadi, superadmin hammasini.
enum AdminRole {
  SUPERADMIN
  OPERATOR
  MODERATOR
}

enum ActorType {
  CLIENT
  MASTER
  SYSTEM
  ADMIN
}

// ────────────────────────────────────────────────────────────── models ──

model User {
  id             String     @id @default(uuid()) @db.Uuid
  phoneNumber    String     @unique @map("phone_number") @db.VarChar(20)
  fullName       String?    @map("full_name") @db.VarChar(120)
  status         UserStatus @default(ACTIVE)
  /// Oxirgi ishlatilgan manzil — { label, lat, lng, ... }
  defaultAddress Json?      @map("default_address")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders        Order[]
  ratings       Rating[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  /// Tasdiqlangan usta hisobi — bitta foydalanuvchida koʻpi bilan bitta.
  master             Master?
  masterApplications MasterApplication[]

  @@map("users")
}

/// Xizmat guruhi ("Elektrik xizmatlari", "Santexnika") — mijoz ilovasidagi
/// bosh sahifa plitkalari va kategoriya ekrani shu jadvaldan quriladi.
/// Taksonomiya admin panel orqali boshqariladi, ilovada hardcode qilinmaydi.
model ServiceGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(120)
  /// Ilova ikonani shu kalit bo'yicha tanlaydi (vektor, temaga moslashadi).
  iconKey   String   @map("icon_key") @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories ServiceCategory[]

  @@index([isActive, sortOrder])
  @@map("service_groups")
}

model ServiceCategory {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(120)
  description     String?          @db.VarChar(500)
  /// Ilova ikonani va xizmat fotosini SHU kalit boʻyicha tanlaydi
  /// (`tap`, `toilet`, `pipes`…). Boʻsh boʻlsa guruhning kaliti ishlatiladi.
  iconKey         String?          @map("icon_key") @db.VarChar(60)
  /// Guruhsiz xizmatlar ham bo'lishi mumkin — shuning uchun nullable.
  groupId         String?          @map("group_id") @db.Uuid
  /// So'mda, butun son. Admin panel orqali tahrirlanadi — hech qachon hardcode qilinmaydi.
  basePrice       Int              @map("base_price")
  complexityLevel ComplexityLevel  @default(SIMPLE) @map("complexity_level")
  /// Kartadagi bir qatorli izoh — roʻyxatda koʻrinadi.
  summary         String?          @db.VarChar(200)
  /// Batafsil tavsif — xizmat sahifasida, bir necha xatboshi boʻlishi mumkin.
  details         String?          @db.Text
  /// «Narx ichiga kiradi» — har bir qator alohida band.
  includes        String[]         @default([])
  /// «Narx ichiga kirmaydi» — kutilmagan qoʻshimcha toʻlovning oldini oladi.
  excludes        String[]         @default([])
  /// Taxminiy davomiylik (daqiqa). `null` — vaqt aytilmaydi, taxmin qilinmaydi.
  durationMinutes Int?             @map("duration_minutes")
  priceKind       ServicePriceKind @default(FIXED) @map("price_kind")
  sortOrder       Int              @default(0) @map("sort_order")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  group   ServiceGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  orders  Order[]
  masters MasterServiceCategory[]
  media   ServiceMedia[]

  @@index([isActive])
  @@index([groupId, sortOrder])
  @@map("service_categories")
}

model Master {
  id                   String                @id @default(uuid()) @db.Uuid
  fullName             String                @map("full_name") @db.VarChar(120)
  phoneNumber          String                @unique @map("phone_number") @db.VarChar(20)
  photoUrl             String?               @map("photo_url") @db.VarChar(500)
  experienceLevel      MasterExperienceLevel @default(NEW) @map("experience_level")
  hasGovCertificate    Boolean               @default(false) @map("has_gov_certificate")
  ratingAvg            Decimal               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int                   @default(0) @map("rating_count")
  completedOrdersCount Int                   @default(0) @map("completed_orders_count")
  status               MasterStatus          @default(OFFLINE)
  /// Admin qo'lda bloklaganda false — avtomatik chetlatish YO'Q (biznes-qoida 5.4)
  isActive             Boolean               @default(true) @map("is_active")
  lastLat              Float?                @map("last_lat")
  lastLng              Float?                @map("last_lng")
  lastLocationAt       DateTime?             @map("last_location_at") @db.Timestamptz(3)
  /// Usta ortidagi ilova hisobi. `null` — eski, qoʻlda kiritilgan ustalar:
  /// ular ariza orqali oʻtmagan va hali ilovaga bogʻlanmagan. Shuning uchun
  /// ustun NULL qabul qiladi (migratsiya faqat qoʻshimcha boʻlishi shart).
  userId               String?               @unique @map("user_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders          Order[]                 @relation("OrderAssignedMaster")
  preferredOrders Order[]                 @relation("OrderPreferredMaster")
  ratings         Rating[]
  categories      MasterServiceCategory[]
  profile         MasterProfile?
  applications    MasterApplication[]

  @@index([status, isActive])
  @@map("masters")
}

/// Ustaning OʻZI AYTGAN maʼlumotlari — `Master` dagi platforma tasdiqlagan
/// koʻrsatkichlardan (reyting, bajarilgan ishlar, davlat sertifikati)
/// ATAYLAB ajratilgan.
///
/// NEGA alohida jadval: bir jadvalda tursa, «oʻzim haqimda» matni bilan
/// reyting bir xil ishonch darajasida koʻrinardi. Mijozga koʻrsatiladigan
/// joyda bu farq yoʻqolmasligi kerak (halollik qoidasi).
model MasterProfile {
  masterId          String    @id @map("master_id") @db.Uuid
  about             String    @db.VarChar(1000)
  /// Usta ishlaydigan tumanlar — hozircha erkin matn roʻyxati; tuman
  /// maʼlumotnomasi K1 (xarita) bosqichida paydo boʻladi.
  districts         String[]
  /// Ish vaqti — mahalliy soat (0–23). Daqiqa yoʻq: usta arizasida ham
  /// soatdan aniqroq vaqt soʻralmaydi.
  workFrom          Int       @map("work_from")
  workTo            Int       @map("work_to")
  /// «Sertifikatim bor» DAʼVOSI. Tasdiq EMAS — tasdiqlangani
  /// `masters.has_gov_certificate` da va uni faqat admin qoʻyadi.
  claimsCertificate Boolean   @default(false) @map("claims_certificate")
  /// Smena qachon ochilgani. Smena yopiq boʻlsa DOIM `null`.
  availableSince    DateTime? @map("available_since") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@map("master_profiles")
}

/// Usta boʻlish arizasi — ilovadan tushadi, moderator koʻrib chiqadi.
///
/// Ariza maʼlumotlari `MasterProfile` ga KOʻCHIRILADI, unga havola
/// qilinmaydi: ariza — muzlatilgan hujjat, moderator aynan nimani
/// koʻrgani keyin ham oʻzgarmasligi kerak; profil esa usta tomonidan
/// tahrirlanadi.
model MasterApplication {
  id                   String                  @id @default(uuid()) @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  fullName             String                  @map("full_name") @db.VarChar(120)
  /// Ariza yuborilgan paytdagi telefon — tokendan olinadi, soʻrov tanasidan
  /// EMAS: aks holda ariza begona raqamga yozilib qolardi.
  phoneNumber          String                  @map("phone_number") @db.VarChar(20)
  profession           String                  @db.VarChar(120)
  experienceLevel      MasterExperienceLevel   @map("experience_level")
  claimsCertificate    Boolean                 @default(false) @map("claims_certificate")
  about                String                  @db.VarChar(1000)
  districts            String[]
  workFrom             Int                     @map("work_from")
  workTo               Int                     @map("work_to")
  /// Usta OʻZI soʻragan xizmatlar. Yakuniy roʻyxatni moderator tasdiqlashda
  /// tanlaydi — soʻralgani va berilgani bir xil boʻlishi shart emas.
  requestedCategoryIds String[]                @map("requested_category_ids") @db.Uuid
  status               MasterApplicationStatus @default(PENDING)
  rejectionReason      String?                 @map("rejection_reason") @db.VarChar(500)
  /// Koʻrib chiqqan admin. FK QOʻYILMAGAN: admin hisobi oʻchirilsa ham
  /// «kim rad etdi» degan javob yoʻqolmasligi kerak.
  reviewedByAdminId    String?                 @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  /// Tasdiqlashda yaratilgan (yoki topilgan) usta yozuvi.
  masterId             String?                 @map("master_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  master Master? @relation(fields: [masterId], references: [id], onDelete: SetNull)

  /// Panel roʻyxati aynan shu tartibda soʻraydi: holat boʻyicha filtr,
  /// ichida yangisidan eskisiga.
  @@index([status, createdAt])
  @@index([userId])
  @@map("master_applications")
}

model MasterServiceCategory {
  masterId   String   @map("master_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  /// Usta shu ishni hozir qabul qiladimi.
  ///
  /// Yozuv OʻCHIRILMAYDI, faqat `false` ga oʻtadi: usta ertaga qaytadan
  /// yoqishi mumkin va tarix (qachon biriktirilgan) saqlanib qoladi.
  /// Katalogga yangi xizmat qoʻshilsa ustada u `false` boʻlib paydo
  /// boʻladi — hech kim soʻramagan ishni avtomatik yuklamaymiz.
  isEnabled  Boolean  @default(true) @map("is_enabled")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  master   Master          @relation(fields: [masterId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([masterId, categoryId])
  @@index([categoryId, isEnabled])
  @@map("master_service_categories")
}

model Order {
  id              String         @id @default(uuid()) @db.Uuid
  /// Mijoz koʻradigan qisqa raqam ("HZ-104901"). DB ketma-ketligi beradi —
  /// ilova yuborgan raqam hech qachon ishlatilmaydi.
  shortId         String         @unique @default(dbgenerated("('HZ-'::text || lpad((nextval('orders_short_id_seq'::regclass))::text, 6, '0'::text))")) @map("short_id") @db.VarChar(20)
  clientId        String         @map("client_id") @db.Uuid
  masterId        String?        @map("master_id") @db.Uuid
  categoryId      String         @map("category_id") @db.Uuid
  description     String         @db.Text
  /// Surat/video havolalari (S3-compatible storage)
  attachmentUrls  String[]       @map("attachment_urls")
  isUrgent        Boolean        @default(false) @map("is_urgent")
  /// Buyurtma yaratilgan paytdagi TOʻLANADIGAN summa (so'mda) — kategoriya narxi
  /// keyin o'zgarsa ham o'zgarmaydi. Har doim `priceBase + priceUrgentFee - discountAmount`.
  price           Int
  /// Hisob-faktura tafsiloti — chek va hamyon shundan quriladi (TZ 2-bo'lim).
  /// Katalogdagi asosiy narx; mijoz butun oqim davomida shuni koʻrgan.
  priceBase       Int            @map("price_base")
  /// Shoshilinchlik qoʻshimchasi — QATʼIY summa, foiz emas.
  priceUrgentFee  Int            @default(0) @map("price_urgent_fee")
  /// Daraja chegirmasi foizi (2 · 4 · 6) va uning soʻmdagi qiymati.
  discountPercent Int            @default(0) @map("discount_percent")
  discountAmount  Int            @default(0) @map("discount_amount")
  /// Mijoz tanlagan toʻlov usuli. Eski buyurtmalarda yoʻq — ular yaratilganda
  /// bu maydon umuman mavjud emas edi, shuning uchun nullable (taxmin yozilmaydi).
  paymentMethod   PaymentMethod? @map("payment_method")
  status          OrderStatus    @default(SEARCHING)

  /// Rejalashtirilgan vaqt. `null` — "imkon qadar tez". Kelajakdagi vaqt boʻlsa
  /// usta qidiruvi SHU VAQTGACHA boshlanmaydi (aks holda ekrandagi
  /// «Rejalashtirilgan» yozuvi yolgʻon boʻlardi).
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)

  /// Mijoz soʻragan usta — SOʻROV, kafolat emas. Usta hisobi oʻchirilsa
  /// soʻrov yoʻqoladi, buyurtma esa qoladi.
  preferredMasterId String? @map("preferred_master_id") @db.Uuid

  /// Ustaning yakunlashdagi izohi (B5 da usta ilovasi toʻldiradi).
  workNote String? @map("work_note") @db.VarChar(300)

  /// Buyurtmani usta rejimi yuritadimi — ilova taymer simulyatsiyasini shu
  /// bayroqqa qarab oʻchiradi.
  handledByMaster Boolean @default(false) @map("handled_by_master")

  queuePosition Int? @map("queue_position")
  etaMinutes    Int? @map("eta_minutes")

  /// { label, lat, lng, entrance?, floor?, apartment?, comment? }
  /// Koordinata NULLABLE: ilovada xarita yoʻq, soxta koordinata yozilmaydi (K1 bosqichigacha).
  clientAddress Json   @map("client_address")
  addressLat    Float? @map("address_lat")
  addressLng    Float? @map("address_lng")

  cancelReason String?      @map("cancel_reason") @db.VarChar(500)
  cancelledBy  CancelledBy? @map("cancelled_by")
  cancelledAt  DateTime?    @map("cancelled_at") @db.Timestamptz(3)

  /// Tayinlash tsikli nazorati (3.4 — max 5 urinish, keyin admin panelga eskalatsiya)
  assignmentAttempts Int       @default(0) @map("assignment_attempts")
  assignedAt         DateTime? @map("assigned_at") @db.Timestamptz(3)
  masterAckedAt      DateTime? @map("master_acked_at") @db.Timestamptz(3)
  enRouteAt          DateTime? @map("en_route_at") @db.Timestamptz(3)
  arrivedAt          DateTime? @map("arrived_at") @db.Timestamptz(3)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(3)

  /// Idempotentlik (biznes-qoida 5.6) — bir xil kalit bilan qayta yuborilsa dublikat yaratilmaydi
  idempotencyKey String? @map("idempotency_key") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client          User                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  master          Master?              @relation("OrderAssignedMaster", fields: [masterId], references: [id], onDelete: Restrict)
  preferredMaster Master?              @relation("OrderPreferredMaster", fields: [preferredMasterId], references: [id], onDelete: SetNull)
  category        ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rating          Rating?
  notifications   Notification[]
  safetyAlerts    SafetyAlert[]
  statusHistory   OrderStatusHistory[]

  @@unique([clientId, idempotencyKey], name: "order_client_idempotency")
  @@index([status, isUrgent, createdAt])
  @@index([clientId, createdAt])
  @@index([masterId])
  @@index([preferredMasterId])
  @@index([scheduledAt])
  @@map("orders")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorType  ActorType    @map("actor_type")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  masterId  String   @map("master_id") @db.Uuid
  stars     Int
  comment   String?  @db.Text
  /// Tanlangan teglar — koʻrsatiladigan matnning oʻzi (ilova ularni chekda chizadi).
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  client User   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  master Master @relation(fields: [masterId], references: [id], onDelete: Restrict)

  @@index([masterId])
  @@map("ratings")
}

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @map("user_id") @db.Uuid
  orderId String?          @map("order_id") @db.Uuid
  type    NotificationType
  payload Json
  sentAt  DateTime         @default(now()) @map("sent_at") @db.Timestamptz(3)
  readAt  DateTime?        @map("read_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, sentAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Push token ro'yxati (FCM) — offline yetkazib berish uchun
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("device_tokens")
}

/// "Boshqa odam keldi" signali — admin/support uchun yuqori ustuvorlikdagi navbat
model SafetyAlert {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @map("order_id") @db.Uuid
  clientId   String            @map("client_id") @db.Uuid
  masterId   String?           @map("master_id") @db.Uuid
  status     SafetyAlertStatus @default(OPEN)
  clientNote String?           @map("client_note") @db.VarChar(1000)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime?         @map("resolved_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("safety_alerts")
}

/// Append-only audit log. UPDATE/DELETE DB trigger orqali bloklangan (migratsiyaga qarang).
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  action     AuditAction
  orderId    String?     @map("order_id") @db.Uuid
  actorType  ActorType   @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  fromStatus String?     @map("from_status") @db.VarChar(50)
  toStatus   String?     @map("to_status") @db.VarChar(50)
  metadata   Json?
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  userAgent  String?     @map("user_agent") @db.VarChar(300)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model OtpRequest {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @map("phone_number") @db.VarChar(20)
  codeHash    String    @map("code_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneNumber, createdAt])
  @@map("otp_requests")
}

/// Refresh token rotation + reuse detection
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(128)
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Admin paneli foydalanuvchisi — mijoz `User` dan BUTUNLAY alohida jadval.
///
/// Sabab: mijoz telefon+SMS bilan kiradi, admin esa email+parol+TOTP bilan.
/// Bitta jadvalga qoʻshilsa, mijozning telefoni bilan admin huquqiga
/// yetib borish yoʻli ochilardi. Ikki jadval — ikki mustaqil kirish yoʻli.
model AdminUser {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(160)
  fullName       String    @map("full_name") @db.VarChar(120)
  /// `scrypt$N$r$p$salt$hash` — node:crypto, tashqi kutubxonasiz.
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  role           AdminRole
  /// TOTP siri base32 da. `null` — hali sozlanmagan (birinchi kirishda majbur).
  totpSecret     String?   @map("totp_secret") @db.VarChar(64)
  totpEnabledAt  DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  isActive       Boolean   @default(true) @map("is_active")
  /// Ketma-ket muvaffaqiyatsiz urinishlar; muvaffaqiyatli kirishda nolga tushadi.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions AdminSession[]

  @@map("admin_users")
}

/// Admin sessiyasi. Token JWT emas — tasodifiy satr, SHA-256 bilan hashlanadi.
///
/// Mijozdagi `RefreshToken` dan farqi: admin sessiyasi FAOLSIZLIK boʻyicha
/// oʻladi (`lastSeenAt` + TTL), muddati boʻyicha emas. Ochiq qoldirilgan
/// admin paneli yarim soatdan keyin oʻzi yopiladi.
model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  adminId    String    @map("admin_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([lastSeenAt])
  @@map("admin_sessions")
}

/// Xizmat kartasidagi rasm va videolar.
///
/// Fayllar bazada emas, diskda (`/var/www/hizmat24/media`) yashaydi va
/// nginx orqali beriladi — bazaga faqat yoʻl yoziladi. Rasmni bazaga
/// solish zaxira nusxani ogʻirlashtiradi va uzatishni sekinlashtiradi.
model ServiceMedia {
  id         String           @id @default(uuid()) @db.Uuid
  categoryId String           @map("category_id") @db.Uuid
  kind       ServiceMediaKind
  /// Saytga nisbatan yoʻl: `/media/xxx.webp`.
  url        String           @db.VarChar(300)
  /// Video uchun muqova rasmi; rasm uchun `null`.
  posterUrl  String?          @map("poster_url") @db.VarChar(300)
  sortOrder  Int              @default(0) @map("sort_order")
  /// Roʻyxatdagi kartada koʻrinadigan asosiy rasm. Kategoriyada bitta.
  isCover    Boolean          @default(false) @map("is_cover")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
  @@map("service_media")
}

enum ServiceMediaKind {
  IMAGE
  VIDEO
}
